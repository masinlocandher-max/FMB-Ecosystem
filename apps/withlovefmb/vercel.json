{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/fmbnews",
      "destination": "/news/",
      "permanent": true
    },
    {
      "source": "/fmbnews/",
      "destination": "/news/",
      "permanent": true
    },
    {
      "source": "/fmbnews/:path*",
      "destination": "/news/:path*",
      "permanent": true
    },
    {
      "source": "/data-center/:path*",
      "has": [{"type": "host", "value": "www.francinemariebautista.com"}],
      "destination": "https://data.francinemariebautista.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "app.francinemariebautista.com"}],
      "destination": "https://yoni.francinemariebautista.com/:path*",
      "permanent": true
    },
    {
      "source": "/fmb&co/:path*",
      "destination": "/fmbandco/:path*",
      "permanent": true
    },
    {
      "source": "/herra.html",
      "destination": "/projects/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/MissIntercontinental",
      "destination": "/MissIntercontinental/index.html"
    },
    {
      "source": "/MissIntercontinental/",
      "destination": "/MissIntercontinental/index.html"
    },
    {
      "source": "/officialpco",
      "destination": "/officialpco/index.html"
    },
    {
      "source": "/officialpco/",
      "destination": "/officialpco/index.html"
    },
    {
      "source": "/about-francine-marie-bautista/early-life-pageantry-advocacy",
      "destination": "/about-francine-marie-bautista/early-life-pageantry-advocacy/index.html"
    },
    {
      "source": "/about-francine-marie-bautista/early-life-pageantry-advocacy/",
      "destination": "/about-francine-marie-bautista/early-life-pageantry-advocacy/index.html"
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "data.francinemariebautista.com"}],
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/index.html"
    },
    {
      "source": "/reading.html",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/content/books/reading.html"
    },
    {
      "source": "/womens-health.html",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/content/books/womens-health.html"
    },
    {
      "source": "/skin-care-makeup.html",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/content/books/skin-care-makeup.html"
    },
    {
      "source": "/coming-out-respect.html",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/content/books/coming-out-respect.html"
    },
    {
      "source": "/men-can-cry.html",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/content/books/men-can-cry.html"
    },
    {
      "source": "/dress-with-intention.html",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/content/books/dress-with-intention.html"
    },
    {
      "source": "/app/:path*",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/:path*"
    },
    {
      "source": "/assets/:path*",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/assets/:path*"
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "yoni.francinemariebautista.com"}],
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "data.francinemariebautista.com"}],
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, max-age=0"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}
      ]
    }
  ]
}
